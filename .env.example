# Copy this file to .env.local and fill in the values.
# .env.local is not committed. Never put real values in this file.

# PostgreSQL connection string, from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Signs staff session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The address the app is served from.
BETTER_AUTH_URL="http://localhost:3000"

# Password for the two sample staff created by `npm run db:seed`.
# At least 12 characters. Development only.
SEED_STAFF_PASSWORD=""

# Nexconn Chat. Get the App Key and App Secret from the Nexconn Console:
# https://console.nexconn.ai/agile/apps/km
# The App Key is public: the browser SDK and the server both read it.
NEXT_PUBLIC_NEXCONN_APP_KEY=""

# The data center chosen when the app was created in the console. The
# browser SDK and the server must use the same one.
#   Browser SDK area code: SG (Singapore), NA (North America), SA, OM, BJ.
NEXT_PUBLIC_NEXCONN_AREA_CODE="SG"

# SERVER ONLY. Signs Platform Chat API requests, such as issuing user
# tokens. Never give it a NEXT_PUBLIC_ name and never import it in a client
# component. Refreshing it in the console invalidates every issued token.
NEXCONN_APP_SECRET=""

# Platform Chat API address for that data center, without https://. The
# backup is used if the primary times out.
#   Singapore:     api.sg-light-api.com   / api-b.sg-light-api.com
#   North America: api.us-light-api.com   / api-b.us-light-api.com
#   Saudi Arabia:  api.sau-light-api.com  / api-b.sau-light-api.com
NEXCONN_API_BASE_URL="api.sg-light-api.com"
NEXCONN_API_BASE_URL_BACKUP="api-b.sg-light-api.com"
